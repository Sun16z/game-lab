{
  "name": "game-lab",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "voice:generate": "node scripts/generate-voice.mjs",
    "dev": "pnpm build:game && pnpm --filter @game-lab/portal dev",
    "dev:game": "pnpm --filter @game-lab/perfect-stack dev",
    "dev:monster": "pnpm --filter @game-lab/monster-math dev",
    "build:game": "pnpm voice:generate && pnpm --filter @game-lab/perfect-stack build && pnpm --filter @game-lab/monster-math build && node scripts/copy-game.mjs",
    "build": "pnpm build:game && pnpm --filter @game-lab/portal build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
