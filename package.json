{
  "name": "game-lab",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "voice:generate": "node scripts/generate-voice.mjs",
    "dev": "pnpm build:game && pnpm --filter @game-lab/portal dev",
    "dev:game": "pnpm --filter @game-lab/perfect-stack dev",
    "dev:monster": "pnpm --filter @game-lab/monster-math dev",
    "dev:color": "pnpm --filter @game-lab/color-lab dev",
    "build:game": "pnpm audio:check && pnpm voice:generate && pnpm --filter @game-lab/perfect-stack build && pnpm --filter @game-lab/monster-math build && pnpm --filter @game-lab/color-lab build && pnpm --filter @game-lab/island-conquest build && node scripts/copy-game.mjs",
    "build": "pnpm build:game && pnpm --filter @game-lab/portal build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "audio:check": "node scripts/check-audio.mjs",
    "size:check": "node scripts/check-game-size.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.152.0"
  }
}
